import sys



def push(stack,top,max):
    if(top<0):
        print("OVERFLOW")
        sys.exit(0)

    print("Enter the value to push into stack: ")
    t= int(input(""))
    stack[top]=t
    top-=1
    return top





def pop(stack,top,max):
    top+=1
    if(top==max):
        print("Underflow")
        sys.exit(1)

    print("The top element", stack[top], "is being removed")
    stack[top]=0
    return top





